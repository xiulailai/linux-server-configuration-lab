# Reconstructed from the lab report screenshots (Figures 3.4.2 - 3.4.11 and 3.7.2).
# Only the lines changed or added in /etc/postfix/main.cf are shown; the rest of the
# stock Rocky Linux 9 main.cf is unchanged and was not captured.

# --- Identity and networking (uncommented / edited) ---
myhostname = tapauserver.bungkus.org
mydomain = bungkus.org
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination = $myhostname, localhost.$mydomain, localhost, $mydomain
mynetworks = 127.0.0.0/8, 192.168.200.0/24

# --- Mailbox delivery via Dovecot LMTP ---
home_mailbox = Maildir/
mailbox_transport = lmtp:unix:private/dovecot-lmtp
smtputf8_enable = no

# --- SASL authentication via Dovecot (added) ---
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous
broken_sasl_auth_clients = yes

# Relay restrictions. The screenshot (Figure 3.4.11) is cut off at the screen edge and the
# keyword at the start looks like "permit_networks". The report text gives the line below,
# and permit_mynetworks is the valid Postfix keyword, so that is what is used here.
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination

# --- TLS for incoming connections (smtpd) ---
smtpd_tls_cert_file = /etc/pki/tls/certs/mailserver.crt
smtpd_tls_key_file = /etc/pki/tls/private/mailserver.key
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1

# --- TLS for outgoing connections (smtp) ---
smtp_tls_security_level = may
smtp_tls_loglevel = 1
# The screenshot (Figure 3.7.2) shows "smtp_cache"; the report text says "smtp_scache".
# Either works as a cache file name. "smtp_scache" mirrors the smtpd line above.
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
smtp_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1
meta_directory = /etc/postfix
shlib_directory = /usr/lib64/postfix
# ... remainder of main.cf not shown in the report
