; Reconstructed from the lab report screenshots (Figure 1.4.5). Path: /var/named/rvs.200.168.192.db
$TTL 86400
@     IN    SOA    tapauserver.bungkus.org.    root.bungkus.org. (
                2001062501 ; serial
                21600      ; refresh after 6 hours
                3600       ; retry after 1 hour
                604800     ; expire after 1 week
                86400 )    ; minimum TTL of 1 day

;Name server information
@     IN    NS     tapauserver.bungkus.org.

;Reverse lookup for name server and IP address to Hostname
3       IN      PTR     tapauserver.bungkus.org.
4       IN      PTR     tapauclient.bungkus.org.
